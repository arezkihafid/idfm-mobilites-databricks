{
  "name": "idfm_frequentation",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 6 1 1,4,7,10 ?",
    "timezone_id": "Europe/Paris",
    "pause_status": "UNPAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "idfm_default_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "<A_REMPLACER_node_type_id>",
        "num_workers": 2,
        "data_security_mode": "SINGLE_USER"
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_frequentation",
      "job_cluster_key": "idfm_default_cluster",
      "notebook_task": {
        "notebook_path": "<REPO_PATH>/databricks/01_bronze/02_bronze_frequentation"
      }
    },
    {
      "task_key": "silver_frequentation",
      "depends_on": [{ "task_key": "bronze_frequentation" }],
      "job_cluster_key": "idfm_default_cluster",
      "notebook_task": {
        "notebook_path": "<REPO_PATH>/databricks/02_silver/01_silver_frequentation"
      }
    },
    {
      "task_key": "gold_faits_kpi",
      "depends_on": [{ "task_key": "silver_frequentation" }],
      "job_cluster_key": "idfm_default_cluster",
      "notebook_task": {
        "notebook_path": "<REPO_PATH>/databricks/03_gold/02_gold_faits_kpi"
      }
    }
  ],
  "email_notifications": {
    "on_failure": ["<A_REMPLACER_email>"]
  },
  "tags": {
    "data_product": "idfm_mobilites",
    "domaine": "frequentation"
  }
}
