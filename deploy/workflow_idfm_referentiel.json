{
  "name": "idfm_referentiel",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "Europe/Paris",
    "pause_status": "UNPAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "idfm_default_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "<A_REMPLACER_node_type_id>",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER"
      }
    }
  ],
  "tasks": [
    {
      "task_key": "setup_catalog",
      "job_cluster_key": "idfm_default_cluster",
      "notebook_task": {
        "notebook_path": "<REPO_PATH>/databricks/00_setup/00_create_catalog_schemas"
      }
    },
    {
      "task_key": "bronze_referentiel",
      "depends_on": [{ "task_key": "setup_catalog" }],
      "job_cluster_key": "idfm_default_cluster",
      "notebook_task": {
        "notebook_path": "<REPO_PATH>/databricks/01_bronze/01_bronze_referentiel"
      }
    },
    {
      "task_key": "silver_referentiel",
      "depends_on": [{ "task_key": "bronze_referentiel" }],
      "job_cluster_key": "idfm_default_cluster",
      "notebook_task": {
        "notebook_path": "<REPO_PATH>/databricks/02_silver/02_silver_referentiel"
      }
    },
    {
      "task_key": "gold_dimensions",
      "depends_on": [{ "task_key": "silver_referentiel" }],
      "job_cluster_key": "idfm_default_cluster",
      "notebook_task": {
        "notebook_path": "<REPO_PATH>/databricks/03_gold/01_gold_dimensions"
      }
    }
  ],
  "email_notifications": {
    "on_failure": ["<A_REMPLACER_email>"]
  },
  "tags": {
    "data_product": "idfm_mobilites",
    "domaine": "referentiel"
  }
}
